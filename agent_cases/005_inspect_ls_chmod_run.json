{
  "name": "inspect_ls_chmod_run",
  "title": "Inspect Mode Then Run",
  "mode": "benchmark",
  "system": "base",
  "prompt": "Call ls on '.', then chmod/run_file tool.py as needed so it runs, then submit that exact stdout.",
  "tools": "run",
  "environment": {
    "kind": "emulated",
    "files": {
      "tool.py": [
        "print('LAUNCHED')"
      ]
    },
    "run_outputs": {
      "tool.py": "LAUNCHED"
    },
    "expected_submit": "LAUNCHED",
    "required_tools": [
      "ls",
      "chmod",
      "run_file",
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 12
}
