{
  "name": "sum_paid_invoices",
  "title": "Count Unpaid Invoices",
  "mode": "benchmark",
  "system": "base",
  "prompt": "In invoices.csv, how many rows have status unpaid? Final answer: integer.",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
