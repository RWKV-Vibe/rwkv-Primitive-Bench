      "invoices.csv": [
        "id,status,amount",
        "1,paid,10",
        "2,unpaid,20",
        "3,unpaid,5",
        "4,paid,8"
      ]
    },
    "expected_submit": "2",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 14,
  "suite": "extra"
}
