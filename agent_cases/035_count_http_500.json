        "10.0.0.4 GET /x 500",
        "10.0.0.5 GET /y 404",
        "10.0.0.6 GET /z 500"
      ]
    },
    "expected_submit": "3",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 12,
  "suite": "extra"
}
