{
  "name": "cron_weekday_job",
  "title": "Cron Weekday Command",
  "mode": "benchmark",
  "system": "base",
  "prompt": "In crontab.txt, what command runs on weekdays at 09:00? Final answer: the command only.",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
    "files": {
      "crontab.txt": [
        "0 2 * * * /usr/bin/backup.sh",
        "0 9 * * 1-5 /usr/bin/standup.sh",
        "30 18 * * 0 /usr/bin/weekly.sh"
      ]
    },
    "expected_submit": "/usr/bin/standup.sh",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 14
}
