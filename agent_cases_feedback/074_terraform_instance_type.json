{
  "name": "terraform_instance_type",
  "title": "Terraform Instance Type",
  "mode": "benchmark",
  "system": "base",
  "prompt": "main.tf: what is aws_instance.app instance_type? Submit the type string.",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
    "files": {
      "main.tf": [
        "resource \"aws_instance\" \"app\" {",
        "  ami           = \"ami-123\"",
        "  instance_type = \"t3.small\"",
        "}",
        "resource \"aws_instance\" \"batch\" {",
        "  instance_type = \"m5.large\"",
        "}"
      ]
    },
    "expected_submit": "t3.small",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 12,
  "suite": "fb_ops"
}
