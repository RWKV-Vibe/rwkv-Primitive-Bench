{
  "name": "invoice_po_bind",
  "title": "Invoice PO Binding",
  "mode": "benchmark",
  "system": "base",
  "prompt": "Which purchase order number is linked to invoice INV-204? Submit the PO number only.",
  "tools": "nav",
  "environment": {
    "kind": "emulated",
    "files": {
      "invoices.csv": [
