{
  "name": "html_anchor_href",
  "title": "HTML Anchor Href",
  "mode": "benchmark",
  "system": "base",
  "prompt": "page.html has <a id=\"docs\" href=\"...\">. Submit the href value for id docs.",
  "tools": "nav",
  "environment": {
