        "<a href=\"/home\">Home</a>",
        "<a id=\"docs\" href=\"/docs/start\">Docs</a>"
      ]
    },
    "expected_submit": "/docs/start",
    "required_tools": [
      "submit"
    ]
  },
  "evaluation": "submit",
  "max_turns": 10,
  "suite": "fb_encoding"
}
